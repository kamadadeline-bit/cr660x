config 'ua3f' 'enabled'
	option enabled '1'

config 'ua3f' 'main'
	option server_mode 'TPROXY'
	option port '1080'
	option bind '0.0.0.0'
	option rewrite_mode 'GLOBAL'
	option ua 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/116.0.5845.97 Safari/537.36 Core/1.116.569.400 QQBrowser/19.7.6765.400'
	option ua_regex ''
	option partial_replace '0'
	option log_level 'WARN'
	option log_lines '1000'
	option header_rewrite ''
	option body_rewrite ''
	option url_redirect ''
	option l3_rewrite_ttl '1'
	option l3_rewrite_ttl_value '64'
	option l3_rewrite_ipid '0'
	option l3_rewrite_tcpts '1'
	option l3_rewrite_tcpwin '0'
	option l3_rewrite_block_quic '0'
	option l3_rewrite_bpf_offload '0'
	option desync_reorder '0'
	option desync_reorder_bytes '1500'
	option desync_reorder_packets '8'
	option desync_inject '0'
	option desync_inject_ttl '3'
	option desync_ports ''
	option mitm_enabled '0'
